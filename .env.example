# Copiar a .env (nunca subir .env al repositorio). En EasyPanel van en "Entorno".
CADABRA_ENTORNO=local
# Supabase (mismo proyecto actual). Rol de la plataforma SIN BYPASSRLS.
CADABRA_DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@HOST:5432/postgres
# Redis: en el VPS, el mismo Redis que usa n8n (las claves de la plataforma usan el prefijo "plat:").
CADABRA_REDIS_URL=redis://localhost:6379/0
# App de Meta "Cadabra IA"
CADABRA_META_APP_SECRET=
CADABRA_META_VERIFY_TOKEN=
CADABRA_LOG_LEVEL=INFO
