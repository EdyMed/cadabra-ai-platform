# Copiar a .env (nunca subir .env al repositorio). En EasyPanel van en "Entorno".
CADABRA_ENTORNO=local
# Supabase (Session pooler, puerto 5432). Migraciones: platform_migrator. API y worker: platform_app.
CADABRA_DATABASE_URL=postgresql+asyncpg://USUARIO.cexowmypklxngbjsxryf:CLAVE@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# Redis: en el VPS, el mismo Redis que usa n8n (las claves de la plataforma usan el prefijo "plat:").
CADABRA_REDIS_URL=redis://localhost:6379/0
CADABRA_LOG_LEVEL=INFO

# App de Meta "Cadabra IA"
CADABRA_META_APP_SECRET=
CADABRA_META_VERIFY_TOKEN=
# Token del usuario del sistema (el mismo que usa n8n para enviar). Solo se usa con MODO_ENSAYO=false.
CADABRA_META_TOKEN=

# Motor del agente (worker)
CADABRA_MODO_ENSAYO=true
CADABRA_OPENAI_API_KEY=
CADABRA_MODELO=gpt-4o-mini

# n8n: integraciones que siguen allá (alerta al vendedor, contador, Google Calendar, coexistencia)
CADABRA_N8N_URL=https://appcadabra-cadabra-project.jmyxxj.easypanel.host
CADABRA_N8N_CLAVE=

# Multimedia (mismos modelos que n8n)
# CADABRA_MODELO_AUDIO=whisper-1
# CADABRA_MODELO_VISION=gpt-4o

# Puerta de entrada: true SOLO cuando el webhook de Meta apunta a la plataforma (ver docs/motor-agente.md)
CADABRA_PUERTA_ENTRADA=false
